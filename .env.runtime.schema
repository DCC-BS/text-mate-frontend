# Runtime variables (used during application execution)
# @plugin(@varlock/proton-pass-plugin@2.0.0)
#
# @initProtonPass()
#
# @defaultSensitive=false
# @import(./.env.azure.schema, enabled=eq($AUTH_MODE, "azure"))
# ---

# @optional @type=port
API_PORT=8000

# API base URL
# @public @type=url @required=not($DUMMY)
NUXT_API_URL=if(
    eq($APP_MODE, dev),
    http://localhost:${API_PORT},
)

# GitHub token for feedback feature
# @sensitive @required=$USE_FEEDBACK
NUXT_FEEDBACK_GITHUB_TOKEN=if(
    eq($APP_MODE, dev), protonPass("pass://DCC-KI/FEEDBACK_DEV_GITHUB_TOKEN/TOKEN", allowMissing=true),
)

# Use dummy data (default: false)
# @type=boolean
DUMMY=eq($APP_MODE, ci)

# Logger level (default: debug)
# @optional @public @type=enum(trace, debug, info, warn, error, fatal)
NUXT_PUBLIC_LOGGER_LOG_LEVEL=ifs(
    eq($APP_MODE, prod), info,
    debug
)

# @type=enum(trace, debug, info, warn, error, fatal)
LOG_LEVEL=ifs(
    eq($APP_MODE, prod), info,
    debug
)

# Disables the Changelogs flow
# @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_CHANGELOG=eq($APP_MODE, ci)

# Disables the Disclaimer flow
# @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_DISCLAIMER=eq($APP_MODE, ci)

# Disables the Onboarding flow
# @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_ONBOARDING=eq($APP_MODE, ci)

# Disables the <SystemStatus> health indicator
# @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_SYSTEM_STATUS=eq($APP_MODE, ci)

# @type=string
NUXT_PUBLIC_APP_CONFIG_APP_LIST_URL_TEMPLATE=http://{APP_NAME}.localhost.ch
