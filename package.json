{
    "name": "nuxt-app",
    "private": true,
    "version": "1.6.3",
    "scripts": {
        "build": "nuxt build",
        "dev": "varlock run -- nuxt dev",
        "dummy": "AUTH_MODE=none DUMMY=true varlock run -- nuxt dev",
        "debug": "varlock run -- nuxt dev --inspect",
        "tsc": "vue-tsc --noEmit -p tsconfig.json",
        "nuxt:prepare": "nuxt prepare",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "biome format --write",
        "check": "biome check --fix",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "e2e:codegen": "playwright codegen http://localhost:3000"
    },
    "dependencies": {
