        "@tiptap/extension-placeholder": "3.27.1",
        "@tiptap/pm": "^3.27.1",
        "@tiptap/starter-kit": "^3.27.1",
        "@tiptap/vue-3": "^3.27.1",
        "@varlock/proton-pass-plugin": "^2.0.0",
        "@varlock/vite-integration": "^1.2.0",
        "@vueuse/core": "^14.3.0",
