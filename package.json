{
    "name": "nuxt-app",
    "private": true,
    "version": "1.5.0",
    "scripts": {
        "build": "nuxt build",
        "dev": "varlock run -- nuxt dev",
        "dummy": "varlock run -- AUTH_MODE=none DUMMY=true nuxt dev",
        "debug": "varlock run -- nuxt dev --inspect",
        "tsc": "vue-tsc --noEmit -p tsconfig.json",
        "nuxt:prepare": "nuxt prepare",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "biome format --write",
        "check": "biome check --fix",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "e2e:codegen": "playwright codegen http://localhost:3000",
        "docker:up": "bash scripts/docker-up.sh",
        "docker:down": "bash scripts/docker-down.sh",
        "env:check": "pass-cli login && bunx varlock load"
    },
    "dependencies": {
        "@dcc-bs/common-ui.bs.js": "^1.2.1",
        "@dcc-bs/communication.bs.js": "^0.1.3",
        "@dcc-bs/dependency-injection.bs.js": "^0.0.16",
        "@dcc-bs/event-system.bs.js": "^1.4.3",
        "@iconify-json/flag": "^1.2.10",
        "@iconify-json/lucide": "^1.2.85",
        "@iconify-json/simple-icons": "^1.2.66",
        "@mohtasham/md-to-docx": "git+https://github.com/DCC-BS/md-to-docx.js#v3.0.0",
        "@nuxt/ui": "4.9.0",
        "@nuxtjs/i18n": "^10.2.1",
        "@nuxtjs/mdc": "0.22.0",
        "@pinia/nuxt": "0.11.3",
        "@tiptap/core": "3.27.1",
        "@tiptap/extension-bubble-menu": "3.27.1",
        "@tiptap/extension-character-count": "3.27.1",
        "@tiptap/extension-floating-menu": "3.27.1",
        "@tiptap/extension-highlight": "3.27.1",
        "@tiptap/extension-history": "3.27.1",
        "@tiptap/extension-paragraph": "3.27.1",
        "@tiptap/extension-placeholder": "3.27.1",
        "@tiptap/pm": "^3.27.1",
        "@tiptap/starter-kit": "^3.27.1",
        "@tiptap/vue-3": "^3.27.1",
        "@varlock/proton-pass-plugin": "^2.0.0",
        "@varlock/vite-integration": "^1.2.0",
        "giget": "^3.0.0",
        "jsdiff": "^1.1.1",
        "motion-v": "^2.0.0",
        "nuxt": "^4.2.2",
        "nuxt-tour": "0.0.40",
        "nuxt-viewport": "2.4.0",
        "openid-client": "^6.8.1",
        "pinia": "^3.0.4",
        "pino": "^10.2.0",
        "prosemirror-schema-basic": "^1.2.4",
        "rehype-stringify": "^10.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "tailwindcss": "^4.1.18",
        "ts-pattern": "^5.9.0",
        "unified": "^11.0.5",
        "varlock": "^1.8.0",
        "vue": "^3.5.39",
        "vue-pdf-embed": "^2.1.3",
        "vue-router": "^5.0.0",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.10",
        "@playwright/test": "^1.57.0",
        "@types/diff": "^7.0.2",
        "@types/node": "26.0.1",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vitest/coverage-v8": "^4.0.17",
        "@vue/test-utils": "^2.4.6",
        "happy-dom": "^20.3.1",
        "pino-pretty": "^13.1.3",
        "typescript": "^6.0.0",
        "vitest": "^4.0.17",
        "vue-tsc": "^3.2.2"
    },
    "trustedDependencies": [
        "@parcel/watcher"
    ],
    "overrides": {
        "prosemirror-model": "1.25.9",
        "prosemirror-view": "1.41.9"
    }
}
