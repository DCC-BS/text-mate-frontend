{
    "name": "text-mate-frontend",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    // Run as root: DevPod's workspace agent and `mise bootstrap packages apply`
    // (apt) need it. Create workspaces from the git URL (see README.md) so the
    // checkout lives in a DevPod-managed volume — with a local-folder workspace on
    // rootless Podman, container writes map to your subuid and pollute the host tree.
    "remoteUser": "root",
    "containerUser": "root",
    "updateRemoteUserUID": false,
    // SELinux-enforcing hosts (Fedora/RHEL): the bind-mounted ~/.gitconfig keeps its
    // host label (user_home_t), which container_t is denied regardless of uid. Opt
    // the container out of SELinux confinement.
    "runArgs": ["--security-opt", "label=disable"],
    // Stages personal coding-agent state on the host (opt-in, see
    // scripts/host-sync.sh) and mounts it read-only. Teammates without staged
    // state get an empty dir and nothing is shared.
    "initializeCommand": "bash .devcontainer/scripts/host-sync.sh",
    "mounts": [
        "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind",
        "source=${localEnv:HOME}/.cache/devcontainer-agent-state,target=/mnt/agent-state,type=bind,readonly"
    ],
    "remoteEnv": {
        "SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}",
        // pass-cli reads the Proton Pass key material from the filesystem
        "PROTON_PASS_KEY_PROVIDER": "fs"
    },
    "forwardPorts": [3000],
    // Installs the full toolchain: `mise install` (bun, node, varlock, usage,
    // pass-cli) plus bun install and the Playwright browser via the mise
    // postinstall hook, and the OS libraries from [bootstrap.packages].
    "postCreateCommand": "bash .devcontainer/scripts/setup.sh",
    // Re-syncs staged agent state on every start (DevPod's dotfiles step runs
    // after postCreate and re-links dot_omp/config.yml over the staged copy).
    "postStartCommand": "bash .devcontainer/scripts/sync-agent.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "github.copilot",
                "github.copilot-chat",
                "nuxtr.nuxt-vscode-extentions",
                "yoavbls.pretty-ts-errors",
                "bradlc.vscode-tailwindcss",
                "biomejs.biome"
            ]
        }
    }
}
