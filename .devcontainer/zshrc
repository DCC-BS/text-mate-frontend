# /root/.zshrc inside the dev container (copied by .devcontainer/Dockerfile).
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
# The mise plugin runs `eval "$(mise activate zsh)"`: shims, env hooks and
# completions for every interactive shell.
plugins=(mise)
source "$ZSH/oh-my-zsh.sh"

# Fish-style arrow-key completion menu on Tab, case-insensitive matches.
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
