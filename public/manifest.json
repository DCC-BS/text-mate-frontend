{
    "$schema": "https://json.schemastore.org/web-manifest-combined.json",
    "name": "TextMate",
    "short_name": "TextMate",
    "description": "Tool for text manipulation",
    "start_url": "/",
    "icons": [
        {
            "src": "/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "theme_color": "#8c4a92",
    "background_color": "#FFFFFF",
    "display": "standalone",
    "shortcuts": [
        {
            "name": "From Clipboard",
            "url": "/?clipboard=true",
            "icons": [
                {
                    "src": "/MaterialSymbolsContentPasteGo.png",
                    "sizes": "512x512"
                }
            ]
        }
    ]
}
