{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "dependencyDashboard": true,
    "ignoreTests": true,
    "extends": ["config:recommended"],
    "internalChecksFilter": "strict",
    "minimumReleaseAge": "14 days",
    "automerge": false,
    "prConcurrentLimit": 2,
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest",
                "lockFileMaintenance"
            ],
            "groupName": "all non-major dependencies",
            "groupSlug": "all-non-major"
        },
        {
            "matchUpdateTypes": ["major"],
            "groupName": "all major dependencies",
            "groupSlug": "all-major"
        },
        {
            "description": "Majors that need a human (DCC dependency routine hold_majors) get their own PR instead of blocking the major group",
            "matchPackageNames": ["typescript", "nuxt", "vue", "node"],
            "matchUpdateTypes": ["major"],
            "groupName": "held major dependencies",
            "groupSlug": "held-major"
        },
        {
            "description": "Held by the DCC dependency routine (2026-10-31): common-ui >= 2.2.1 imports vue-pdf-embed CSS in PdfViewer.vue, which breaks the Nitro server build (Could not resolve './PdfViewer-styles-1.mjs-!~{018}~.js'). Remove once common-ui is fixed.",
            "matchPackageNames": ["@dcc-bs/common-ui.bs.js"],
            "allowedVersions": "<2.2.1"
        }
    ],
    "lockFileMaintenance": {
        "enabled": false
    }
}
